{
  "ConnectionStrings": {
    // This placeholder is overridden by the environment variable
    // ConnectionStrings__DefaultConnection in Kubernetes (via ConfigMap/Secret).
    // Do NOT store real credentials here.
    "DefaultConnection": "Server=<RDS_ENDPOINT>;Database=QuickApp;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },

  "OIDC": {
    "Certificates": {
      // Required for multi-replica deployments. Without a shared certificate,
      // each pod generates ephemeral signing/encryption keys and tokens issued
      // by one pod cannot be validated by another.
      // Override via environment variables: OIDC__Certificates__Path and
      // OIDC__Certificates__Password (set in k8s/secret.yaml).
      "Path": "",
      "Password": ""
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
